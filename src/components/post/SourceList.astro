---
import type { PostView } from '../../lib/content';

interface Props {
  sources: PostView['sources'];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources">
    <h2 id="sources">Tài liệu tham khảo</h2>
    <ol>
      {sources.map((source) => (
        <li>
          {source.url ? (
            <a href={source.url} class="link" rel="noopener">
              <cite>{source.title}</cite>
            </a>
          ) : (
            <cite>{source.title}</cite>
          )}
          {source.author && <span class="author">{source.author}</span>}
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .sources {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  ol {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.875rem;
    padding-inline-start: 1.25rem;
    color: var(--muted);
    list-style: decimal;
    font-size: var(--text-small);
    line-height: 1.55;
  }

  li {
    padding-inline-start: 0.25rem;
    overflow-wrap: break-word;
  }

  li::marker {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  cite {
    color: var(--text);
  }

  .author::before {
    content: ' · ';
  }
</style>
