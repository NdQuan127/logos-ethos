---
import type { PostView } from '../../lib/content';

interface Props {
  sources: PostView['sources'];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="mt-16 border-t border-line pt-6" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="mb-4 text-[0.8125rem] font-medium text-muted">
      Tài liệu tham khảo
    </h2>
    <ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-muted">
      {sources.map((source) => (
        <li class="break-words">
          {source.author && <span>{source.author}, </span>}
          {source.url ? (
            <a
              href={source.url}
              class="text-fg italic underline decoration-lilac-deep decoration-wavy decoration-[1.5px] underline-offset-[0.22em]"
              rel="noopener"
            >
              {source.title}
            </a>
          ) : (
            <cite>{source.title}</cite>
          )}
        </li>
      ))}
    </ol>
  </section>
)}
