---
import type { HTMLAttributes } from 'astro/types';
import ArticleCard from './ArticleCard.astro';
import type { PostView } from '../../lib/content';

interface Props extends HTMLAttributes<'ul'> {
  posts: PostView[];
  /** Render an <ol> when order matters, e.g. parts of a series. */
  ordered?: boolean;
  /** Extra attributes for each <li>, e.g. data hooks for client scripts. */
  itemAttributes?: (post: PostView) => Record<string, unknown>;
}

const { posts, ordered = false, itemAttributes, class: className, ...attrs } = Astro.props;
const List = ordered ? 'ol' : 'ul';
---

<List class:list={['grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8', className]} {...attrs}>
  {posts.map((post) => (
    <li {...itemAttributes?.(post)}>
      <ArticleCard post={post} />
    </li>
  ))}
</List>
