---
import type { HTMLAttributes } from 'astro/types';
import ArticleCard from './ArticleCard.astro';
import AnimateOnScroll from '../ui/AnimateOnScroll.astro';
import type { PostView } from '../../lib/content';

interface Props extends HTMLAttributes<'ul'> {
  posts: PostView[];
  /** Render an <ol> when order matters, e.g. parts of a series. */
  ordered?: boolean;
  /** Fade cards in as they scroll into view, staggered across each row. */
  animate?: boolean;
}

const { posts, ordered = false, animate = false, class: className, ...attrs } = Astro.props;
const List = ordered ? 'ol' : 'ul';
const columns = 3;
---

<List class:list={['grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8', className]} {...attrs}>
  {posts.map((post, index) => (
    <li>
      {animate ? (
        <AnimateOnScroll animation="fade-up" delay={(index % columns) * 100}>
          <ArticleCard post={post} />
        </AnimateOnScroll>
      ) : (
        <ArticleCard post={post} />
      )}
    </li>
  ))}
</List>
