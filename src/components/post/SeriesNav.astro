---
import type { PostView, SeriesView } from '../../lib/content';

interface Props {
  series: SeriesView;
  /** Every post of the series, in reading order. */
  posts: PostView[];
  current: PostView;
}

const { series, posts, current } = Astro.props;
const index = posts.findIndex((post) => post.slug === current.slug);
const prev = index > 0 ? posts[index - 1] : undefined;
const next = index < posts.length - 1 ? posts[index + 1] : undefined;
---

<nav class="mb-10 border border-line p-4 font-sans text-sm" aria-label={`Loạt bài: ${series.title}`}>
  <p class="font-mono text-xs uppercase tracking-widest text-muted mb-1">
    Loạt bài · Phần {index + 1}/{posts.length}
  </p>
  <a href={series.href} class="font-serif text-lg text-fg hover:text-accent transition-colors">
    {series.title}
  </a>
  <ol class="mt-3 space-y-1 list-decimal pl-5 text-muted">
    {posts.map((post) => (
      <li>
        {post.slug === current.slug ? (
          <span aria-current="page" class="text-fg font-medium">{post.title}</span>
        ) : (
          <a href={post.href} class="hover:text-accent transition-colors">{post.title}</a>
        )}
      </li>
    ))}
  </ol>
  {(prev || next) && (
    <div class="mt-4 flex justify-between gap-4 border-t border-line pt-3">
      {prev ? <a href={prev.href} rel="prev" class="min-h-11 flex items-center hover:text-accent transition-colors">← Phần trước</a> : <span />}
      {next && <a href={next.href} rel="next" class="min-h-11 flex items-center hover:text-accent transition-colors">Phần sau →</a>}
    </div>
  )}
</nav>
