---
import Badge from '../ui/Badge.astro';
import type { TagView } from '../../lib/content';

interface Props {
  tags: TagView[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" aria-label="Thẻ">
    {tags.map((tag) => (
      <li>
        <Badge href={tag.href}>{tag.name}</Badge>
      </li>
    ))}
  </ul>
)}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 2.5rem;
    list-style: none;
  }
</style>
