---
import PostCover from './PostCover.astro';
import type { PostView } from '../../lib/content';

interface Props {
  post: PostView;
}

const { post } = Astro.props;
---

<a
  href={post.href}
  class="group block h-full border border-line text-fg no-underline transition-colors duration-300 hover:border-fg/30"
>
  <PostCover category={post.category} cover={post.cover} coverAlt={post.coverAlt} />
  <div class="p-5">
    <p
      class="mb-3 flex items-center gap-2 font-mono text-xs font-semibold tracking-wide"
      style={{ color: post.category.color }}
    >
      <span
        class="h-1.5 w-1.5 shrink-0 rounded-full"
        aria-hidden="true"
        style={{ background: post.category.color }}
      ></span>
      <span>{post.category.name}</span>
    </p>
    <h3 class="mb-2 line-clamp-2 font-serif text-xl leading-snug transition-colors group-hover:text-accent">
      {post.title}
    </h3>
    <p class="mb-4 line-clamp-3 font-sans text-sm leading-relaxed text-muted">{post.description}</p>
    <p class="flex items-center gap-2 font-mono text-xs tracking-wide text-muted">
      <time datetime={post.isoDate}>{post.dateLabel}</time>
      <span aria-hidden="true">·</span>
      <span>{post.readingTime} phút đọc</span>
    </p>
  </div>
</a>
