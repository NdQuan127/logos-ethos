---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** `sidebar`: sticky column on wide screens. `inline`: collapsible box above the article. */
  variant: 'sidebar' | 'inline';
}

const { headings, variant } = Astro.props;
const sidebar = variant === 'sidebar';
const Outer = sidebar ? 'aside' : 'details';
const Label = sidebar ? 'p' : 'summary';
---

<Outer
  class={
    sidebar
      ? 'hidden xl:block xl:sticky xl:top-24 xl:self-start xl:max-h-[calc(100vh-8rem)] xl:overflow-y-auto font-sans text-sm'
      : 'xl:hidden mb-10 border border-line font-sans text-sm'
  }
>
  <Label
    class={
      sidebar
        ? 'font-mono text-xs uppercase tracking-widest text-muted mb-3'
        : 'min-h-11 flex items-center px-4 cursor-pointer font-mono text-xs uppercase tracking-widest text-muted'
    }
  >
    Mục lục
  </Label>
  <nav
    aria-label={sidebar ? 'Mục lục bài viết' : 'Mục lục bài viết (thu gọn)'}
    class={sidebar ? undefined : 'px-4 pb-4'}
  >
    <ol class={sidebar ? 'space-y-2' : 'space-y-3'}>
      {headings.map((heading) => (
        <li class={heading.depth === 3 ? 'pl-4' : ''}>
          <a href={`#${heading.slug}`} data-toc-link class="text-muted hover:text-accent transition-colors">
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</Outer>
