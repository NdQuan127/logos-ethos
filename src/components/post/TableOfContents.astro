---
/**
 * The article's sections. `sidebar`: a fixed column beside the text on wide
 * screens, with a marker that follows the section being read. `inline`: a
 * collapsible card above the text on narrower ones.
 */
import { ArrowUp, ChevronDown } from '@lucide/astro';

interface Entry {
  slug: string;
  text: string;
}

interface Props {
  entries: Entry[];
  variant: 'sidebar' | 'inline';
}

const { entries, variant } = Astro.props;
---

{variant === 'sidebar' ? (
  <nav class="toc" aria-label="Mục lục">
    <p class="label">Trong bài</p>
    <div class="track">
      <span class="marker" data-toc-marker aria-hidden="true" />
      <ol>
        {entries.map((entry) => (
          <li>
            <a href={`#${entry.slug}`} data-toc-link>
              {entry.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
    <a href="#main-content" class="top">
      <ArrowUp size={14} stroke-width={1.75} aria-hidden="true" />
      Lên đầu trang
    </a>
  </nav>
) : (
  <details class="card toc-inline">
    <summary>
      <span>Trong bài</span>
      <span class="n">{entries.length} mục</span>
      <ChevronDown class="chev" size={16} stroke-width={1.75} aria-hidden="true" />
    </summary>
    <nav aria-label="Mục lục">
      <ol>
        {entries.map((entry) => (
          <li>
            <a href={`#${entry.slug}`}>{entry.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .toc {
    display: none;
  }

  @media (min-width: 76rem) {
    .toc {
      position: fixed;
      top: 6rem;
      left: calc(50% + var(--container-col) / 2 + 3.5rem);
      display: block;
      width: 13rem;
      max-height: calc(100svh - 8rem);
      overflow-y: auto;
      font-size: var(--text-caption);
      scrollbar-width: none;
    }

    .toc-inline {
      display: none;
    }
  }

  .label {
    margin-bottom: 0.75rem;
    color: var(--fg);
    font-weight: 500;
  }

  .track {
    position: relative;
    border-inline-start: 1px solid var(--border);
  }

  .toc ol {
    display: grid;
    gap: 0.125rem;
    list-style: none;
  }

  .toc li a {
    display: block;
    padding: 0.25rem 0 0.25rem 0.875rem;
    color: var(--muted);
    line-height: 1.45;
    text-decoration: none;
    text-wrap: pretty;
    transition: color 150ms ease;
  }

  .toc li a[aria-current='location'] {
    color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .toc a:hover {
      color: var(--fg);
    }
  }

  .marker {
    position: absolute;
    top: 0;
    left: -1px;
    width: 1px;
    height: 1px;
    background-color: var(--fg);
    opacity: 0;
    transform-origin: top;
    scale: 1 0;
    transition:
      translate 220ms var(--ease-out),
      scale 220ms var(--ease-out),
      opacity 150ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .marker {
      transition: opacity 150ms ease;
    }
  }

  .top {
    min-height: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .toc-inline {
    margin-top: 2rem;
    background-color: var(--surface);
    font-size: var(--text-ui);
    interpolate-size: allow-keywords;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    color: var(--fg);
    font-weight: 500;
    list-style: none;
    border-radius: inherit;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .n {
    color: var(--muted);
    font-weight: 400;
  }

  summary :global(.chev) {
    margin-inline-start: auto;
    color: var(--muted);
    transition: rotate 200ms var(--ease-out);
  }

  .toc-inline[open] summary :global(.chev) {
    rotate: 180deg;
  }

  .toc-inline::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height 200ms var(--ease-out),
      opacity 150ms ease,
      content-visibility 200ms allow-discrete;
  }

  .toc-inline[open]::details-content {
    height: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-inline::details-content {
      transition:
        opacity 150ms ease,
        content-visibility 150ms allow-discrete;
    }
  }

  .toc-inline ol {
    display: grid;
    gap: 0.125rem;
    padding: 0 1rem 0.875rem 2.25rem;
    color: var(--muted);
  }

  .toc-inline li::marker {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .toc-inline a {
    display: block;
    padding-block: 0.3rem;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .toc-inline a:hover,
    .top:hover {
      color: var(--fg);
    }
  }
</style>
