---
interface Props {
  quote: string;
  author: string;
}

const { quote, author } = Astro.props;
---

<section class="w-full py-24 px-6 md:px-12 bg-line dark:bg-transparent border-y border-line">
  <div class="max-w-4xl mx-auto text-center relative">
    <span
      class="absolute -top-16 left-1/2 -translate-x-1/2 font-serif text-[10rem] leading-none text-fg/8 dark:text-[rgba(255,255,255,0.06)] select-none"
      aria-hidden="true"
    >
      “
    </span>
    <blockquote class="relative z-10">
      <p class="font-serif text-3xl md:text-5xl leading-tight text-fg italic mb-8">{quote}</p>
      <footer class="font-mono text-xs uppercase tracking-[0.3em] text-muted dark:text-[rgba(255,255,255,0.45)]">
        <span class="inline-block w-8 h-px bg-fg/20 dark:bg-[rgba(255,255,255,0.18)] align-middle mr-4"></span>
        {author}
      </footer>
    </blockquote>
  </div>
</section>
