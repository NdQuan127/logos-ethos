---
import { Circle, Grid3x3, Triangle } from '@lucide/astro';
import type { CategoryView, Summary } from '../../lib/content';

interface Props {
  categories: Summary<CategoryView>[];
}

const { categories } = Astro.props;
const icons = [Grid3x3, Circle, Triangle];
const topics = categories.slice(0, 3).map(({ item, count }, index) => ({
  Icon: icons[index % icons.length],
  name: item.name,
  count,
  description: item.description,
  href: item.href,
}));
---

<header class="relative w-full py-24 md:py-32 px-6 md:px-12 border-b border-line">
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8 animate-fade-in-up">
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[1.05] text-fg mb-8 font-medium tracking-tight">
          <span class="italic block text-muted font-light">Về những giới hạn của</span>
          Sự hiểu biết
        </h1>
        <blockquote class="border-l-2 border-accent pl-6 py-1 max-w-2xl">
          <p class="font-sans text-fg text-lg md:text-xl leading-relaxed italic">
            &quot;Hành động cuối cùng của lý trí là thừa nhận rằng có một lượng vô hạn những thứ vượt tầm của nó.&quot;
          </p>
          <footer class="mt-4 font-mono text-sm tracking-widest text-muted uppercase not-italic">
            — Blaise Pascal
          </footer>
        </blockquote>
      </div>
      {topics.length > 0 && (
        <nav class="lg:col-span-4 flex flex-col justify-end animate-fade-in" style="animation-delay: 400ms" aria-label="Khám phá theo chủ đề">
          <p class="font-mono text-xs uppercase tracking-widest text-muted mb-4">Chủ đề</p>
          <div class="font-mono text-sm text-muted">
            {topics.map(({ Icon, name, count, description, href }) => (
              <a
                href={href}
                class="group flex items-center gap-4 py-4 border-b border-line hover:text-fg hover:border-fg/30 transition-colors duration-200"
              >
                <Icon size={16} aria-hidden="true" class="shrink-0 group-hover:text-accent transition-colors" />
                <span class="flex-1 min-w-0">
                  <span class="block text-fg">{name}</span>
                  {description && <span class="block text-xs">{description}</span>}
                </span>
                <span class="shrink-0 text-xs">{count} bài</span>
              </a>
            ))}
          </div>
        </nav>
      )}
    </div>
  </div>
</header>
