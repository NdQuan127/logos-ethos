---
interface Props {
  code?: string;
  lang?: string;
}

const { code = '', lang = '' } = Astro.props;
---

<figure class="my-8 overflow-hidden border border-[var(--border-color)] bg-[var(--surface-raised)]">
  <figcaption class="flex items-center justify-between border-b border-[var(--border-color)] px-4 py-2 font-mono text-xs uppercase tracking-widest text-[var(--muted)]">
    <span>{lang || 'code'}</span>
    <button data-code-copy class="hover:text-[var(--accent-primary)] transition-colors" type="button">
      Sao chép
    </button>
  </figcaption>
  <pre class="overflow-x-auto p-4 text-sm leading-relaxed"><code data-code-text>{code}</code></pre>
</figure>
