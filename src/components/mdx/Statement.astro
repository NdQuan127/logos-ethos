---
/**
 * Shared shell for theorem-like blocks. Use the named wrappers in MDX
 * (<Theorem>, <Definition>, …) rather than this component directly.
 * Claims (theorem, lemma, proposition, corollary) set their body in italic, as in print.
 */
const STATEMENT_LABELS = {
  theorem: 'Định lý',
  lemma: 'Bổ đề',
  proposition: 'Mệnh đề',
  corollary: 'Hệ quả',
  definition: 'Định nghĩa',
  axiom: 'Tiên đề',
  example: 'Ví dụ',
  remark: 'Nhận xét',
} as const;

const CLAIMS = new Set(['theorem', 'lemma', 'proposition', 'corollary']);

type StatementKind = keyof typeof STATEMENT_LABELS;

interface Props {
  kind: StatementKind;
  /** Optional name, e.g. "Bất toàn thứ nhất" or "Gödel, 1931". */
  title?: string;
}

const { kind, title } = Astro.props;
const label = STATEMENT_LABELS[kind];
---

<div
  class:list={['statement', { claim: CLAIMS.has(kind) }]}
  role="group"
  aria-label={title ? `${label}: ${title}` : label}
>
  <p class="statement-head">
    <span class="statement-label">{label}</span>
    {title && <span class="statement-title">{title}</span>}
  </p>
  <div class="statement-body">
    <slot />
  </div>
</div>
