---
interface Props {
  author?: string;
}

const { author } = Astro.props;
---

<figure class="my-12 border-y border-line py-8 text-center">
  <blockquote class="font-serif text-2xl md:text-3xl italic leading-snug text-fg">
    <slot />
  </blockquote>
  {author && <figcaption class="mt-5 font-mono text-xs uppercase tracking-widest text-muted">{author}</figcaption>}
</figure>
