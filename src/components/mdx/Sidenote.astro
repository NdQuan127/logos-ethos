---
interface Props {
  label?: string;
}

const { label = 'Ghi chú bên lề' } = Astro.props;
const id = `sidenote-${crypto.randomUUID().slice(0, 8)}`;
---

<aside class="sidenote my-6 font-sans text-sm text-[var(--muted)] leading-relaxed" data-open="false">
  <button
    type="button"
    data-sidenote-toggle
    class="sidenote-toggle min-h-11 items-center font-mono text-xs uppercase tracking-widest text-[var(--accent-primary)] border border-[var(--border-color)] px-3 mb-3"
    aria-expanded="false"
    aria-controls={id}
  >
    {label}
  </button>
  <div id={id} class="sidenote-body border-l border-[var(--border-color)] pl-4">
    <slot />
  </div>
</aside>
