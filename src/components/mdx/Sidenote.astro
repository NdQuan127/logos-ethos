---
interface Props {
  label?: string;
}

const { label = 'Ghi chú bên lề' } = Astro.props;
const id = `sidenote-${crypto.randomUUID().slice(0, 8)}`;
---

<aside class="sidenote my-6 font-sans text-sm text-muted leading-relaxed" data-open="false">
  <button
    type="button"
    data-sidenote-toggle
    class="sidenote-toggle min-h-11 items-center font-mono text-xs uppercase tracking-widest text-accent border border-line px-3 mb-3"
    aria-expanded="false"
    aria-controls={id}
  >
    {label}
  </button>
  <div id={id} class="sidenote-body border-l border-line pl-4">
    <slot />
  </div>
</aside>
