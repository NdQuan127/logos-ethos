---
/**
 * A lettered note (a, b, c) written inline, right after the word it explains:
 * `nhất quán<Sidenote>…</Sidenote>`. The letter opens the note in a popover
 * (scripts/notes.ts). Without scripts the note reads inline, in brackets.
 * The markup stays on one line: whitespace would show as a space before the letter.
 */
const id = `sidenote-${crypto.randomUUID().slice(0, 8)}`;
---

<!-- prettier-ignore -->
<span class="sidenote"><button type="button" class="note-ref sidenote-ref" data-note={id} aria-label="Ghi chú" aria-expanded="false"></button><span id={id} class="sidenote-body" role="note"><slot /></span></span>
