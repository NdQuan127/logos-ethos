---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { PROSE_IMAGE_SIZES } from '../../lib/rehype-blocks';

interface Props {
  /** An imported local image: `import hilbert from './hilbert.jpg'`. */
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Credit line shown after the caption. */
  credit?: string;
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="figure">
  <Image src={src} alt={alt} sizes={PROSE_IMAGE_SIZES} />
  {(caption || credit || Astro.slots.has('default')) && (
    <figcaption>
      {caption}
      <slot />
      {credit && <span class="figure-credit">{credit}</span>}
    </figcaption>
  )}
</figure>
