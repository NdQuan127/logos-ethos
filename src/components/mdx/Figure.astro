---
import type { ImageMetadata } from 'astro';
import ProseImage from './ProseImage.astro';

interface Props {
  /** An imported local image: `import hilbert from './hilbert.jpg'`. */
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Credit line shown after the caption. */
  credit?: string;
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="figure">
  <ProseImage src={src} alt={alt} />
  {(caption || credit || Astro.slots.has('default')) && (
    <figcaption>
      {caption}
      <slot />
      {credit && <span class="figure-credit">{credit}</span>}
    </figcaption>
  )}
</figure>
