---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** An imported local image: `import hilbert from './hilbert.jpg'`. */
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Credit line shown after the caption. */
  credit?: string;
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="figure">
  <Image src={src} alt={alt} widths={[640, 960, 1280]} sizes="(min-width: 768px) 38rem, 100vw" />
  {(caption || credit || Astro.slots.has('default')) && (
    <figcaption>
      {caption}
      <slot />
      {credit && <span class="figure-credit">{credit}</span>}
    </figcaption>
  )}
</figure>
