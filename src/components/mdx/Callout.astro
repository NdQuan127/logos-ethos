---
import { Info, Lightbulb, TriangleAlert } from '@lucide/astro';

interface Props {
  type?: 'note' | 'warning' | 'idea';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const labels = { note: 'Ghi chú', warning: 'Lưu ý', idea: 'Ý tưởng' };
const Icon = { note: Info, warning: TriangleAlert, idea: Lightbulb }[type];
---

<aside class="callout" data-type={type} aria-label={title ?? labels[type]}>
  <Icon class="callout-icon" size={16} stroke-width={1.75} aria-hidden="true" />
  <div class="callout-body">
    <p class="callout-title">{title ?? labels[type]}</p>
    <slot />
  </div>
</aside>
