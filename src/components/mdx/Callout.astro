---
interface Props {
  type?: 'note' | 'warning' | 'idea';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const labels = {
  note: 'Ghi chú',
  warning: 'Lưu ý',
  idea: 'Ý tưởng',
};
---

<aside class={`my-8 rounded-xl bg-surface px-5 py-4 font-sans text-base callout-${type}`}>
  <p class="mb-2 text-[0.8125rem] font-medium text-accent">{title ?? labels[type]}</p>
  <div class="leading-relaxed text-fg">
    <slot />
  </div>
</aside>
