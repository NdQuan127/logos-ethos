---
interface Props {
  type?: 'note' | 'warning' | 'idea';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const labels = {
  note: 'Ghi chú',
  warning: 'Lưu ý',
  idea: 'Ý tưởng',
};
---

<aside class={`my-8 border-l-2 border-accent bg-accent/5 px-5 py-4 font-sans callout-${type}`}>
  <p class="font-mono text-xs uppercase tracking-widest text-accent mb-2">
    {title ?? labels[type]}
  </p>
  <div class="text-fg leading-relaxed">
    <slot />
  </div>
</aside>
