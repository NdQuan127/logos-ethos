---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CategoryView } from '../lib/content';

interface Props {
  category: CategoryView;
  /** Real cover image; without it the category glyph is shown. */
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Tailwind aspect-ratio class; pass '' to let the parent size the cover */
  ratio?: string;
  /** Tailwind size class for the glyph */
  glyph?: string;
  /** `sizes` attribute for the responsive cover image */
  sizes?: string;
  /** Load eagerly when the cover is above the fold */
  eager?: boolean;
  class?: string;
}

const {
  category,
  cover,
  coverAlt = '',
  ratio = 'aspect-[16/9]',
  glyph = 'text-[7rem]',
  sizes = '(min-width: 1024px) 24rem, (min-width: 768px) 50vw, 100vw',
  eager = false,
  class: className = '',
} = Astro.props;
---

{cover ? (
  <div
    class:list={['relative w-full overflow-hidden bg-[var(--surface-raised)]', ratio, className]}
    style={{ borderTop: `3px solid ${category.color}` }}
  >
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>
) : (
  <div
    class:list={['relative flex w-full items-center justify-center overflow-hidden bg-[var(--surface-raised)]', ratio, className]}
    style={{ borderTop: `3px solid ${category.color}` }}
    aria-hidden="true"
  >
    <span class={`block select-none font-serif italic leading-none opacity-30 ${glyph}`} style={{ color: category.color }}>
      {category.symbol}
    </span>
  </div>
)}
