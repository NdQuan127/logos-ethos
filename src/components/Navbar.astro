---
import { Menu, X } from 'lucide-astro';
import ThemeButton from './ThemeButton.astro';

const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/#tuyen-tap', label: 'Tuyển tập', match: null },
  { href: '/blog/', label: 'Bài viết', match: '/blog' },
  { href: '/da-luu/', label: 'Đã lưu', match: '/da-luu' },
  { href: '/about/', label: 'Về chúng tôi', match: '/about' },
].map((link) => ({
  ...link,
  current: link.match !== null && (pathname === `${link.match}/` || pathname.startsWith(`${link.match}/`)),
}));
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[var(--accent-primary)] focus:text-[var(--background)] focus:rounded-sm focus:font-mono focus:text-xs"
>
  Chuyển đến nội dung chính
</a>

<nav
  class="w-full py-5 px-6 md:px-12 flex justify-between items-center z-50 border-b border-[var(--border-color)] bg-[var(--background)]/90 dark:bg-[var(--surface-raised)]/90 backdrop-blur-md sticky top-0 transition-colors duration-300"
  aria-label="Điều hướng chính"
>
  <a href="/" class="flex items-center gap-3" aria-label="Logos & Ethos — trang chủ">
    <div class="w-6 h-6 bg-[var(--foreground)] text-[var(--background)] flex items-center justify-center font-mono text-xs font-bold rounded-sm" aria-hidden="true">
      L
    </div>
    <span class="font-sans font-bold tracking-tight text-[var(--foreground)] uppercase text-sm">
      Logos &amp; Ethos
    </span>
  </a>

  <div class="hidden md:flex gap-8 font-sans text-sm font-medium">
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={link.current ? 'page' : undefined}
        class:list={[
          'border-b-2 py-1 transition-colors hover:text-[var(--accent-primary)]',
          link.current
            ? 'border-[var(--accent-primary)] text-[var(--foreground)]'
            : 'border-transparent text-[var(--muted)]',
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>

  <div class="flex items-center gap-1 text-[var(--foreground)]">
    <ThemeButton />
    <button
      data-nav-toggle
      class="md:hidden p-3 hover:bg-[var(--foreground)]/5 rounded-full transition-colors"
      aria-label="Mở menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="relative block w-[18px] h-[18px]">
        <span data-nav-menu-icon class="absolute inset-0 transition-all duration-300"><Menu size={18} /></span>
        <span data-nav-close-icon class="absolute inset-0 transition-all duration-300 opacity-0 -rotate-90 scale-75"><X size={18} /></span>
      </span>
    </button>
  </div>
</nav>

<div
  id="mobile-menu"
  data-nav-drawer
  class="fixed inset-0 z-[60] md:hidden transition-all duration-300 invisible pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-label="Menu điều hướng"
  aria-hidden="true"
>
  <div data-nav-backdrop class="absolute inset-0 bg-[var(--foreground)]/30 backdrop-blur-sm transition-opacity duration-300 opacity-0" aria-hidden="true" />
  <div
    data-nav-panel
    class="absolute top-0 right-0 h-full w-72 bg-[var(--background)] border-l border-[var(--border-color)] p-8 flex flex-col gap-8 shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] translate-x-full"
  >
    <div class="flex justify-between items-center">
      <span class="font-mono text-xs uppercase tracking-widest text-[var(--muted)]">Menu</span>
      <button data-nav-close class="p-3 hover:bg-[var(--foreground)]/5 rounded-full transition-colors" aria-label="Đóng menu">
        <X size={18} aria-hidden="true" />
      </button>
    </div>
    <nav class="flex flex-col gap-6" aria-label="Menu điều hướng di động">
      {navLinks.map((link, index) => (
        <a
          href={link.href}
          data-nav-link
          aria-current={link.current ? 'page' : undefined}
          style={`transition-delay: ${index * 60 + 80}ms`}
          class:list={[
            'font-serif text-2xl transition-all duration-300 hover:text-[var(--accent-primary)] focus:outline-none focus-visible:text-[var(--accent-primary)] opacity-0 translate-x-4',
            link.current ? 'text-[var(--accent-primary)]' : 'text-[var(--foreground)]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</div>
