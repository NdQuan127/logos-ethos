---
import { Moon, Sun } from '@lucide/astro';
import Button from '../ui/Button.astro';
import IconSwap from '../ui/IconSwap.astro';
---

<Button variant="ghost" icon label="Đổi nền" shortcut="T" data-theme-toggle>
  <IconSwap class="theme-swap">
    <Moon slot="from" size={16} stroke-width={1.75} />
    <Sun slot="to" size={16} stroke-width={1.75} />
  </IconSwap>
</Button>

<style>
  /* The icon names the theme you would switch to: a moon in light, a sun in dark. */
  :global(.dark) .theme-swap > :global(:first-child) {
    opacity: 0;
    scale: 0.6;
    filter: blur(3px);
  }

  :global(.dark) .theme-swap > :global(:last-child) {
    opacity: 1;
    scale: 1;
    filter: none;
  }
</style>
