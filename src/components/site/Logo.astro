---
import { site } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  class:list={['font-display text-[1.375rem] leading-none font-medium tracking-[-0.01em] whitespace-nowrap', className]}
  aria-label={`${site.title} — trang chủ`}
>
  Logos <i class="text-accent italic">&amp;</i> Ethos
</a>
