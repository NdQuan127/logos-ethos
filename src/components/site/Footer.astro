---
import { site } from '../../config/site';
import { routes } from '../../lib/routes';

const currentYear = new Date().getFullYear();
const links = [...site.footer.explore, ...site.footer.contact, { href: routes.rss, label: 'RSS' }];
---

<footer class="slab slab-kraft pb-16 sm:pb-24">
  <div class="wrap grid gap-10 sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <p class="font-display text-[clamp(2.5rem,1.6rem+3vw,4.25rem)] leading-none tracking-[-0.02em]">
        Cảm ơn đã
        <br />
        <em class="italic">đọc chậm.</em>
      </p>
      <p class="mt-4 max-w-md text-[0.9375rem] leading-[1.6] text-muted">
        {site.title} là sổ tay cá nhân. Không quảng cáo, không theo dõi. Bài mới đến khi viết xong.
      </p>
    </div>
    <nav aria-label="Liên kết cuối trang">
      <ul class="flex flex-col gap-1 text-[0.9375rem] sm:text-right">
        {links.map((link) => (
          <li>
            <a href={link.href} class="inline-block py-1.5 transition-colors duration-[160ms] hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <p class="wrap mt-12 text-[0.8125rem] text-muted">
    © {currentYear} {site.title}
  </p>
</footer>
