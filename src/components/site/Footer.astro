---
import { ArrowRight } from '@lucide/astro';
import Logo from './Logo.astro';
import { enabledLinks, site } from '../../config/site';

const currentYear = new Date().getFullYear();
const linkClass = 'font-sans text-sm text-fg hover:text-accent transition-colors';
---

<footer class="w-full py-16 px-6 md:px-12 border-t border-line bg-canvas">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="md:col-span-1">
      <Logo class="mb-4" />
      <p class="font-sans text-xs text-muted leading-relaxed max-w-xs">
        {site.description}
      </p>
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-1">Khám phá</h3>
      {enabledLinks(site.footer.explore).map((link) => (
        <a href={link.href} class:list={[linkClass, 'flex items-center gap-1 group w-fit']}>
          {link.label}
          <ArrowRight size={12} class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" aria-hidden="true" />
        </a>
      ))}
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-1">Liên hệ</h3>
      {enabledLinks(site.footer.contact).map((link) => (
        <a href={link.href} class={linkClass}>{link.label}</a>
      ))}
    </div>
  </div>
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-line flex justify-between items-center">
    <p class="text-muted text-xs font-sans">
      © {currentYear} {site.title}. Mọi quyền được bảo lưu.
    </p>
  </div>
</footer>
