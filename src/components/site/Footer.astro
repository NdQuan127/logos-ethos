---
import Kbd from '../ui/Kbd.astro';
import { site } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="wrap footer">
  <nav aria-label="Liên kết cuối trang">
    {site.footer.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
  <p class="keys" aria-hidden="true">
    <span>
      <Kbd>Ctrl K</Kbd> tìm
    </span>
    <span>
      <Kbd>T</Kbd> sáng/tối
    </span>
  </p>
  <p>
    © {year} {site.title}
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 6rem;
    padding-block: 2rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
    color: var(--muted);
    font-size: var(--text-caption);
  }

  /* The top rule spans the column only, not the gutters. */
  .footer {
    background: linear-gradient(var(--border), var(--border)) var(--pad-start) 0 /
      calc(100% - var(--pad-start) - var(--pad-end)) 1px no-repeat;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    min-height: 1.5rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--fg);
    }
  }

  .keys {
    display: flex;
    gap: 1rem;
  }

  .keys span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  /* Shortcuts mean nothing without a keyboard. */
  @media (pointer: coarse) {
    .keys {
      display: none;
    }
  }
</style>
