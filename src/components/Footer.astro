---
import { ArrowRight } from 'lucide-astro';

const currentYear = new Date().getFullYear();
const exploreLinks = [
  { href: '/#tuyen-tap', label: 'Tuyển tập' },
  { href: '/blog/', label: 'Tất cả bài viết' },
  { href: '/da-luu/', label: 'Bài đã lưu' },
  { href: '/about/', label: 'Về chúng tôi' },
];
---

<footer class="w-full py-16 px-6 md:px-12 border-t border-[var(--border-color)] bg-[var(--background)]">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="md:col-span-1">
      <a href="/" class="flex items-center gap-3 mb-4" aria-label="Logos & Ethos — trang chủ">
        <div class="w-6 h-6 bg-[var(--foreground)] text-[var(--background)] flex items-center justify-center font-mono text-xs font-bold rounded-sm" aria-hidden="true">L</div>
        <span class="font-sans font-bold tracking-tight text-[var(--foreground)] uppercase text-sm">Logos &amp; Ethos</span>
      </a>
      <p class="font-sans text-xs text-[var(--muted)] leading-relaxed max-w-xs">
        Về những giới hạn của sự hiểu biết — nơi toán học và triết học cùng đặt câu hỏi cho lý trí.
      </p>
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="font-mono text-xs uppercase tracking-widest text-[var(--muted)] mb-1">Khám phá</h3>
      {exploreLinks.map((link) => (
        <a href={link.href} class="font-sans text-sm text-[var(--foreground)] hover:text-[var(--accent-primary)] transition-colors flex items-center gap-1 group w-fit">
          {link.label}
          <ArrowRight size={12} class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" aria-hidden="true" />
        </a>
      ))}
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="font-mono text-xs uppercase tracking-widest text-[var(--muted)] mb-1">Liên hệ</h3>
      <a href="/about/#contact" class="font-sans text-sm text-[var(--foreground)] hover:text-[var(--accent-primary)] transition-colors">Liên hệ</a>
      <a href="mailto:contact@logos-ethos.web.app" class="font-sans text-sm text-[var(--foreground)] hover:text-[var(--accent-primary)] transition-colors">Email</a>
    </div>
  </div>
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-[var(--border-color)] flex justify-between items-center">
    <p class="text-[var(--muted)] text-xs font-sans">
      © {currentYear} Logos &amp; Ethos. Mọi quyền được bảo lưu.
    </p>
  </div>
</footer>
