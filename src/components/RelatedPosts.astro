---
import { ArrowRight } from 'lucide-astro';
import { getCategoryMeta } from '../lib/category-utils';
import type { BlogPostView } from '../lib/blog';

interface Props {
  posts: BlogPostView[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="mt-20 pt-12 border-t border-[var(--border-color)]" aria-label="Bài viết liên quan">
    <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--muted)] mb-8">
      Có thể bạn cũng quan tâm
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {posts.map((post) => {
        const meta = getCategoryMeta(post.category);
        return (
          <a href={`/blog/${post.slug}/`} class="group flex flex-col gap-3 p-4 border border-[var(--border-color)] hover:border-[var(--accent-primary)] transition-colors rounded-sm">
            <span class="font-mono text-xs font-semibold tracking-wide" style={{ color: meta.color }}>{post.category}</span>
            <h3 class="font-serif text-lg text-[var(--foreground)] group-hover:text-[var(--accent-primary)] transition-colors leading-snug">{post.title}</h3>
            <p class="font-sans text-sm text-[var(--muted)] leading-relaxed line-clamp-2">{post.excerpt}</p>
            <div class="mt-auto font-mono text-xs text-[var(--muted)] flex items-center justify-between">
              <time datetime={post.isoDate}>{post.date}</time>
              <ArrowRight size={14} class="group-hover:translate-x-1 transition-transform" aria-hidden="true" />
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
