---
interface Props {
  animation?: 'fade-up' | 'scale-up';
  delay?: number;
  threshold?: number;
  class?: string;
}

const {
  animation = 'fade-up',
  delay = 0,
  threshold = 0.1,
  class: className = '',
} = Astro.props;
---

<div
  class={`animate-on-scroll ${animation} ${className}`}
  data-animate
  data-animate-delay={delay}
  data-animate-threshold={threshold}
>
  <slot />
</div>
