---
import SiteLayout from '../layouts/SiteLayout.astro';
import QuoteSection from '../components/blocks/QuoteSection.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { site } from '../config/site';
import { getPosts, summarizeCategories } from '../lib/content';
import { formatCount } from '../lib/format';
import { routes } from '../lib/routes';

const categories = summarizeCategories(await getPosts());

// TODO(content): replace this sample bio with the author's real introduction.
const author = {
  name: 'Người viết',
  initials: 'L&E',
  bio: [
    'Đây là nội dung mẫu: hãy thay bằng vài câu giới thiệu thật về bạn — xuất phát điểm, vì sao bạn viết về toán học và triết học, và điều bạn mong người đọc mang theo sau mỗi bài.',
  ],
};
const pillars = [
  {
    symbol: 'Λ',
    latin: 'Logos',
    meaning: 'Lý trí & Logic',
    description:
      'Logos — tiếng Hy Lạp cho "từ ngữ, lý trí, nguyên lý" — là nền tảng của tư duy khoa học. Chúng tôi tin rằng toán học không chỉ là công cụ, mà là ngôn ngữ mà qua đó vũ trụ tự diễn đạt mình.',
  },
  {
    symbol: 'Η',
    latin: 'Ethos',
    meaning: 'Đạo đức & Nhân sinh',
    description:
      'Ethos — "tính cách, tinh thần" — nhắc nhở rằng lý trí không thể tách rời khỏi giá trị. Triết học là câu hỏi liên tục về ý nghĩa của sự sống, cái đẹp, và cái thiện.',
  },
];
---

<SiteLayout
  title="Giới thiệu"
  description="Logos & Ethos — ghi chép chậm về toán học, học máy, triết học và chính trị."
  canonicalPath={routes.about}
>
  <PageHeader eyebrow="Giới thiệu" title="Câu hỏi đi trước" titleAccent="những câu trả lời" />
  <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-label="Sứ mệnh">
    <div class="mx-auto max-w-[52rem]">
      <p class="eyebrow mb-5">Sứ mệnh</p>
      <p class="mb-6 font-display text-2xl leading-snug text-fg md:text-3xl">
        Lý trí có những đường biên mà chính nó không thể nhìn thấy. Toán học và triết học là hai cách tiếp cận khác nhau
        để sờ vào những đường biên đó.
      </p>
      <p class="text-lg leading-relaxed text-muted">
        Logos & Ethos là nơi dành cho những ai thấy rằng một định lý toán học có thể gây rúng động ngang một câu hỏi
        triết học, và rằng câu hỏi quan trọng hơn câu trả lời.
      </p>
    </div>
  </section>
  <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-label="Hai trụ cột">
    <div class="mx-auto grid max-w-[60rem] grid-cols-1 gap-6 md:grid-cols-2">
      {pillars.map((pillar) => (
        <div class="rounded-[20px] bg-surface p-8 md:p-10">
          <div class="mb-4 font-display text-6xl leading-none text-accent-soft italic" aria-hidden="true">
            {pillar.symbol}
          </div>
          <p class="eyebrow mb-2">{pillar.latin}</p>
          <h2 class="mb-5 font-display text-3xl font-medium text-fg">{pillar.meaning}</h2>
          <p class="leading-relaxed text-muted">{pillar.description}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-labelledby="author-heading">
    <div class="mx-auto grid max-w-[52rem] grid-cols-1 items-start gap-10 md:grid-cols-[10rem_minmax(0,1fr)]">
      <div
        class="flex h-40 w-40 items-center justify-center rounded-[20px] bg-paper-lilac font-display text-4xl text-fg italic"
        aria-hidden="true"
      >
        {author.initials}
      </div>
      <div>
        <p class="eyebrow mb-4">Người viết</p>
        <h2 id="author-heading" class="mb-5 font-display text-3xl font-medium text-fg">
          {author.name}
        </h2>
        {author.bio.map((paragraph) => (
          <p class="mb-4 font-serif text-lg leading-relaxed text-fg">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>
  {categories.length > 0 && (
    <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-labelledby="topics-heading">
      <div class="mx-auto max-w-[52rem]">
        <p class="eyebrow mb-4">Đang viết về</p>
        <h2 id="topics-heading" class="mb-6 font-display text-3xl font-medium text-fg">
          Các lĩnh vực
        </h2>
        <ul>
          {categories.map(({ item, count }) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                class="group flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-4 text-fg transition-colors duration-[160ms] hover:text-accent"
              >
                <span class="font-display text-2xl">{item.name}</span>
                <span class="text-sm text-muted">
                  {item.description} · {formatCount(count)} bài
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <section id="contact" class="w-full px-5 py-20 sm:px-8" aria-label="Liên hệ">
    <div class="mx-auto max-w-[52rem] text-center">
      <p class="eyebrow mb-5">Liên hệ</p>
      <p class="mb-8 font-display text-3xl leading-snug text-fg">
        Có ý tưởng, câu hỏi, hay chỉ muốn nói về Gödel lúc nửa đêm?
      </p>
      <a href={`mailto:${site.email}`} class="btn">
        Gửi thư cho chúng tôi
      </a>
    </div>
  </section>
  <QuoteSection quote="Triết học là sự luyện tập để học cách chết." author="Plato (Phaidon)" />
</SiteLayout>
