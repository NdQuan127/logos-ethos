---
import { ArrowRight } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';
import { getPosts, summarizeCategories } from '../lib/content';
import { routes } from '../lib/routes';

const categories = summarizeCategories(await getPosts());

// TODO(content): write the author's real introduction. The section stays hidden while `bio` is empty.
const author = {
  name: 'Người viết',
  bio: [] as string[],
};

const names = [
  {
    symbol: 'Λ',
    word: 'Logos',
    fragment: 'Bạn sẽ không tìm thấy đường biên của tâm hồn, dù đi hết mọi nẻo đường: logos của nó sâu đến thế.',
    source: 'Heraclitus, mảnh B45',
  },
  {
    symbol: 'Η',
    word: 'Ethos',
    fragment: 'Ethos của con người là số phận của nó.',
    source: 'Heraclitus, mảnh B119',
  },
];
---

<SiteLayout title="Giới thiệu" description={site.description} canonicalPath={routes.about}>
  <div class="wrap">
    <header class="hero">
      <h1>Đi cho đến chỗ lý trí dừng lại.</h1>
      <p>Lý trí có những đường biên mà chính nó không thể nhìn thấy. Sổ tay này là những lần tôi cố đi tới đó.</p>
    </header>

    <section aria-labelledby="name">
      <h2 id="name">Tên gọi</h2>
      <p class="sub">Hai mảnh của Heraclitus.</p>
      <div class="names">
        {names.map((name) => (
          <figure class="card">
            <p class="word">
              <span class="symbol" aria-hidden="true">
                {name.symbol}
              </span>
              {name.word}
            </p>
            <blockquote>
              <p>“{name.fragment}”</p>
            </blockquote>
            <figcaption>{name.source}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {author.bio.length > 0 && (
      <section aria-labelledby="author">
        <h2 id="author">{author.name}</h2>
        <div class="bio">
          {author.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    )}

    {categories.length > 0 && (
      <section aria-labelledby="topics">
        <h2 id="topics">Lĩnh vực</h2>
        <p class="sub">Nếu bạn muốn bắt đầu từ đâu đó.</p>
        <ul class="topics">
          {categories.map(({ item, count }) => (
            <li>
              <a href={item.href}>
                <i class="dot" style={`--tone: var(--${item.tone})`} aria-hidden="true" />
                <span class="t">{item.name}</span>
                <span class="d">{item.description}</span>
                <span class="n">{count} bài</span>
                <ArrowRight class="arr" size={14} stroke-width={1.75} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Liên hệ</h2>
      <p class="sub">Nếu tôi sai ở một bước nào đó, tôi muốn biết.</p>
      <div class="actions">
        <Button href={`mailto:${site.email}`}>Viết thư cho tôi</Button>
        <Button href={routes.rss} variant="outline">
          Theo dõi qua RSS
        </Button>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .hero {
    padding-top: clamp(3rem, 10vh, 6rem);
  }

  h1 {
    max-width: 30rem;
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
  }

  .hero p {
    max-width: 33rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--text-prose);
    line-height: 1.6;
  }

  section {
    margin-top: 4rem;
  }

  h2 {
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .sub {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-small);
  }

  .names {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 36rem) {
    .names {
      grid-template-columns: 1fr 1fr;
    }
  }

  .names figure {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  .word {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .symbol {
    color: var(--fg);
    font-size: 1.5rem;
    line-height: 1;
  }

  blockquote {
    flex: 1;
    margin-top: 1rem;
    color: var(--fg);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  figcaption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .bio {
    display: grid;
    gap: 1em;
    margin-top: 1rem;
    font-size: var(--text-prose);
    line-height: var(--text-prose--line-height);
  }

  .topics {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .topics li {
    border-bottom: 1px solid var(--border);
  }

  .topics a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.125rem 0.75rem;
    margin-inline: -0.75rem;
    padding: 0.875rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .t {
    color: var(--fg);
    font-weight: 500;
  }

  .d {
    grid-column: 2;
    grid-row: 2;
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .n {
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .topics :global(.arr) {
    color: var(--faint);
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .topics a:hover {
      background-color: var(--hover);
    }

    .topics a:hover :global(.arr) {
      color: var(--fg);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
</style>
