---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { site } from '../config/site';
import { getPosts, summarizeCategories } from '../lib/content';
import { formatCount } from '../lib/format';
import { routes } from '../lib/routes';

const categories = summarizeCategories(await getPosts());

// TODO(content): write the author's real introduction. The section stays hidden while `bio` is empty.
const author = {
  name: 'Người viết',
  initials: 'L&E',
  bio: [] as string[],
};

const names = [
  {
    symbol: 'Λ',
    word: 'Logos',
    fragment: 'Bạn sẽ không tìm thấy đường biên của tâm hồn, dù đi hết mọi nẻo đường: logos của nó sâu đến thế.',
    source: 'Heraclitus, mảnh B45',
  },
  {
    symbol: 'Η',
    word: 'Ethos',
    fragment: 'Ethos của con người là số phận của nó.',
    source: 'Heraclitus, mảnh B119',
  },
];
---

<SiteLayout title="Giới thiệu" description={site.description} canonicalPath={routes.about}>
  <PageHeader eyebrow="Giới thiệu" title="Đi cho đến" titleAccent="chỗ lý trí dừng lại." />

  <section class="w-full border-b border-line px-5 pb-16 sm:px-8" aria-label="Về sổ tay này">
    <div class="mx-auto max-w-[52rem]">
      <p class="font-display text-2xl leading-snug text-fg md:text-3xl">
        Lý trí có những đường biên mà chính nó không thể nhìn thấy. Sổ tay này là những lần tôi cố đi tới đó.
      </p>
    </div>
  </section>

  <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-labelledby="name-heading">
    <div class="mx-auto max-w-[60rem]">
      <div class="mx-auto mb-10 max-w-[52rem]">
        <p class="eyebrow mb-4">Tên gọi</p>
        <h2 id="name-heading" class="font-display text-3xl font-medium text-fg">
          Hai mảnh của <em class="italic">Heraclitus.</em>
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {names.map((name) => (
          <figure class="flex flex-col rounded-[20px] bg-surface p-8 md:p-10">
            <div class="mb-4 font-display text-6xl leading-none text-accent-soft italic" aria-hidden="true">
              {name.symbol}
            </div>
            <p class="eyebrow mb-6">{name.word}</p>
            <blockquote class="mb-3 font-display text-2xl leading-snug text-fg italic">
              <p>“{name.fragment}”</p>
            </blockquote>
            <figcaption class="text-[0.8125rem] text-muted">{name.source}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {author.bio.length > 0 && (
    <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-labelledby="author-heading">
      <div class="mx-auto grid max-w-[52rem] grid-cols-1 items-start gap-10 md:grid-cols-[10rem_minmax(0,1fr)]">
        <div
          class="flex h-40 w-40 items-center justify-center rounded-[20px] bg-paper-lilac font-display text-4xl text-fg italic"
          aria-hidden="true"
        >
          {author.initials}
        </div>
        <div>
          <p class="eyebrow mb-4">Người viết</p>
          <h2 id="author-heading" class="mb-5 font-display text-3xl font-medium text-fg">
            {author.name}
          </h2>
          {author.bio.map((paragraph) => (
            <p class="mb-4 font-serif text-lg leading-relaxed text-fg">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>
  )}

  {categories.length > 0 && (
    <section class="w-full border-b border-line px-5 py-16 sm:px-8" aria-labelledby="topics-heading">
      <div class="mx-auto max-w-[52rem]">
        <p class="eyebrow mb-4">Lối vào</p>
        <h2 id="topics-heading" class="mb-6 font-display text-3xl font-medium text-fg">
          Nếu bạn muốn bắt đầu <em class="italic">từ đâu đó.</em>
        </h2>
        <ul>
          {categories.map(({ item, count }) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                class="group flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-4 text-fg transition-colors duration-[160ms] hover:text-accent"
              >
                <span class="font-display text-2xl">{item.name}</span>
                <span class="text-sm text-muted">{formatCount(count)} bài</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="contact" class="w-full px-5 py-20 sm:px-8" aria-labelledby="contact-heading">
    <div class="mx-auto max-w-[52rem] text-center">
      <p class="eyebrow mb-5">Liên hệ</p>
      <h2 id="contact-heading" class="mb-8 font-display text-3xl leading-snug text-fg">
        Nếu tôi sai ở một bước nào đó, <em class="italic">tôi muốn biết.</em>
      </h2>
      <a href={`mailto:${site.email}`} class="btn">
        Viết thư cho tôi
      </a>
    </div>
  </section>
</SiteLayout>
