---
import ListingLayout from '../../../layouts/ListingLayout.astro';
import PostGrid from '../../../components/post/PostGrid.astro';
import { getActiveSeries, getPosts, getSeriesPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getActiveSeries(posts).map((series) => ({
    params: { series: series.id },
    props: { series, posts: getSeriesPosts(posts, series.id) },
  }));
}

const { series, posts } = Astro.props;
---

<ListingLayout
  title={`Loạt bài: ${series.title}`}
  description={series.description}
  canonicalPath={series.href}
  header={{ eyebrow: 'Loạt bài', title: series.title, description: `${series.description} · ${posts.length} phần` }}
  sectionLabel={`Các phần của loạt bài ${series.title}`}
>
  <PostGrid posts={posts} ordered />
</ListingLayout>
