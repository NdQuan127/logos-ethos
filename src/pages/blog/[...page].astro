---
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import CategoryFilter from '../../components/post/CategoryFilter.astro';
import PostGrid from '../../components/post/PostGrid.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { site } from '../../config/site';
import { getPosts, summarizeCategories } from '../../lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const categories = summarizeCategories(posts);
  return paginate(posts, { pageSize: site.pageSize, props: { categories, total: posts.length } });
}) satisfies GetStaticPaths;

const { page, categories, total } = Astro.props;
---

<ListingLayout
  title="Tất cả bài viết"
  description="Khám phá toàn bộ bộ sưu tập bài viết về Toán học và Triết học của Logos & Ethos."
  page={page}
  header={{
    eyebrow: 'Tuyển tập',
    dot: true,
    title: 'Tất cả',
    titleAccent: 'bài viết',
    description: `${total} bài viết về Toán học, Triết học và những giao thoa của tư duy con người.`,
  }}
  sectionLabel="Danh sách bài viết"
>
  <CategoryFilter categories={categories} total={total} />
  {page.data.length > 0 ? (
    <PostGrid posts={page.data} />
  ) : (
    <EmptyState title="Chưa có bài viết nào." description="Hãy quay lại sớm — chúng tôi đang viết!" />
  )}
</ListingLayout>
