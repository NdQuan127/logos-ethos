---
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import CategoryFilter from '../../components/post/CategoryFilter.astro';
import PostList from '../../components/post/PostList.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { site } from '../../config/site';
import { getPosts, summarizeCategories } from '../../lib/content';
import { formatCount } from '../../lib/format';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const categories = summarizeCategories(posts);
  return paginate(posts, { pageSize: site.pageSize, props: { categories, total: posts.length } });
}) satisfies GetStaticPaths;

const { page, categories, total } = Astro.props;
const domains = new Intl.ListFormat('vi').format(categories.map(({ item }) => item.name));
---

<ListingLayout
  title="Tất cả bài viết"
  description="Mọi bài viết của Logos & Ethos về toán học, học máy, triết học và chính trị."
  page={page}
  header={{
    eyebrow: 'Mọi bài viết',
    title: 'Tất cả',
    titleAccent: 'bài viết',
    description: total > 0 ? `${formatCount(total)} bài về ${domains}.` : undefined,
  }}
  sectionLabel="Danh sách bài viết"
>
  <CategoryFilter categories={categories} total={total} class="mb-6" />
  {page.data.length > 0 ? (
    <PostList posts={page.data} />
  ) : (
    <EmptyState title="Chưa có bài viết nào." description="Hãy quay lại sớm — chúng tôi đang viết!" />
  )}
</ListingLayout>
