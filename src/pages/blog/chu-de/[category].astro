---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import CategoryFilter from '../../../components/CategoryFilter.astro';
import Footer from '../../../components/Footer.astro';
import Navbar from '../../../components/Navbar.astro';
import { getAllPosts, summarizeCategories } from '../../../lib/blog';
import { getCategoryMeta } from '../../../lib/category-utils';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = summarizeCategories(posts);
  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      name: category.name,
      categories,
      total: posts.length,
      posts: posts.filter((post) => post.category === category.name),
    },
  }));
}

const { category } = Astro.params;
const { name, categories, total, posts } = Astro.props;
const meta = getCategoryMeta(name);
---

<BaseLayout
  title={`Chủ đề: ${name}`}
  description={`Các bài viết thuộc chủ đề ${name} của Logos & Ethos.`}
  canonicalPath={`/blog/chu-de/${category}/`}
>
  <div class="min-h-screen flex flex-col relative font-serif">
    <Navbar />
    <main id="main-content" class="flex-grow">
      <header class="w-full py-20 md:py-28 px-6 md:px-12 border-b border-[var(--border-color)]">
        <div class="max-w-7xl mx-auto relative z-10">
          <p class="mb-6 font-mono text-xs uppercase tracking-widest animate-fade-in" style={{ color: meta.color }}>Chủ đề</p>
          <h1 class="font-serif text-5xl md:text-7xl text-[var(--foreground)] font-medium leading-tight animate-fade-in-up">{name}</h1>
          {meta.description && (
            <p class="font-sans text-[var(--muted)] text-lg mt-6 max-w-xl leading-relaxed animate-fade-in-up">
              {meta.description} · {posts.length} bài viết
            </p>
          )}
        </div>
      </header>
      <section class="w-full py-16 px-6 md:px-12" aria-label={`Bài viết thuộc chủ đề ${name}`}>
        <div class="max-w-7xl mx-auto">
          <CategoryFilter categories={categories} total={total} activeSlug={category} />
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <li>
                <ArticleCard post={post} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
