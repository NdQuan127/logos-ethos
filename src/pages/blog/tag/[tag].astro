---
import ListingLayout from '../../../layouts/ListingLayout.astro';
import PostGrid from '../../../components/post/PostGrid.astro';
import { getPosts, summarizeTags } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return summarizeTags(posts).map(({ item }) => ({
    params: { tag: item.slug },
    props: { tag: item, posts: posts.filter((post) => post.tags.some((tag) => tag.slug === item.slug)) },
  }));
}

const { tag, posts } = Astro.props;
---

<ListingLayout
  title={`Thẻ: ${tag.name}`}
  description={`Các bài viết gắn thẻ ${tag.name} trên Logos & Ethos.`}
  canonicalPath={tag.href}
  header={{ eyebrow: 'Thẻ', title: `#${tag.name}`, description: `${posts.length} bài viết` }}
  sectionLabel={`Bài viết gắn thẻ ${tag.name}`}
>
  <PostGrid posts={posts} />
</ListingLayout>
