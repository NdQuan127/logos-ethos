---
import { ArrowRight } from 'lucide-astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import FeaturedSection from '../components/blocks/FeaturedSection.astro';
import HeroSection from '../components/blocks/HeroSection.astro';
import QuoteSection from '../components/blocks/QuoteSection.astro';
import ArticleCard from '../components/post/ArticleCard.astro';
import AnimateOnScroll from '../components/ui/AnimateOnScroll.astro';
import { getPosts, pickFeatured, summarizeCategories } from '../lib/content';
import { routes } from '../lib/routes';

const allPosts = await getPosts();
const featuredPost = pickFeatured(allPosts);
const recentPosts = allPosts.filter((post) => post !== featuredPost);
const categories = summarizeCategories(allPosts);
---

<SiteLayout class="overflow-hidden transition-colors duration-500">
  <HeroSection categories={categories} />
  {featuredPost && (
    <AnimateOnScroll animation="fade-up" threshold={0.05}>
      <FeaturedSection post={featuredPost} />
    </AnimateOnScroll>
  )}
  <section id="tuyen-tap" class="w-full py-24 px-6 md:px-12" aria-label="Bài viết mới">
    <div class="max-w-7xl mx-auto">
      <AnimateOnScroll animation="fade-up">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 pb-6 border-b border-line">
          <div>
            <span class="font-mono text-xs text-muted uppercase tracking-widest block mb-2">
              Mới cập nhật
            </span>
            <h2 class="font-serif text-3xl md:text-4xl text-fg">
              Suy ngẫm &amp; Lý luận
            </h2>
          </div>
          <a href={routes.blog} class="font-mono text-xs uppercase tracking-wider text-fg hover:text-accent min-h-11 mt-4 md:mt-0 transition-colors flex items-center gap-2">
            Xem tất cả <ArrowRight size={14} aria-hidden="true" />
          </a>
        </div>
      </AnimateOnScroll>
      {recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" role="list" aria-label="Danh sách bài viết">
          {recentPosts.map((post, index) => (
            <div role="listitem">
              <AnimateOnScroll animation="fade-up" delay={index * 100}>
                <ArticleCard post={post} />
              </AnimateOnScroll>
            </div>
          ))}
        </div>
      ) : (
        <p class="font-sans text-muted text-center py-12">
          Chưa có bài viết nào. Hãy quay lại sớm!
        </p>
      )}
    </div>
  </section>
  <AnimateOnScroll animation="scale-up" threshold={0.2}>
    <QuoteSection quote="Toán học là âm nhạc của lý trí." author="James Joseph Sylvester" />
  </AnimateOnScroll>
</SiteLayout>
