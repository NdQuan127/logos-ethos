---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostFeed from '../components/post/PostFeed.astro';
import { site } from '../config/site';
import { getPosts } from '../lib/content';

const posts = await getPosts();
---

<SiteLayout>
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">{site.description}</h1>
      <p>{site.intro}</p>
    </section>

    <section class="posts" aria-labelledby="posts-title">
      <div class="posts-head">
        <h2 id="posts-title">Bài viết</h2>
        <span>{posts.length} bài</span>
      </div>
      <PostFeed posts={posts} />
    </section>
  </div>
</SiteLayout>

<style>
  .hero {
    padding-top: clamp(3rem, 10vh, 6rem);
  }

  .hero h1 {
    max-width: 30rem;
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
  }

  .hero p {
    max-width: 33rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--text-prose);
    line-height: 1.6;
  }

  .posts {
    margin-top: 4rem;
  }

  .posts-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .posts-head h2 {
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .posts-head span {
    color: var(--muted);
    font-size: var(--text-caption);
  }
</style>
