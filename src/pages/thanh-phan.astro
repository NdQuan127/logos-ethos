---
/**
 * The design system on one page: tokens first, components as they are built.
 * Internal: not linked from the site, kept out of search results and the sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

interface Swatch {
  name: string;
  token: string;
  role: string;
  /** Minimum contrast on --bg; omitted for colours nobody has to read. */
  min?: number;
}

const neutrals: Swatch[] = [
  { name: 'Nền', token: '--bg', role: 'Nền trang' },
  { name: 'Bề mặt', token: '--surface', role: 'Thẻ, khối code' },
  { name: 'Rê chuột', token: '--hover', role: 'Nền khi rê chuột' },
  { name: 'Nổi', token: '--raised', role: 'Popover, hộp thoại' },
  { name: 'Viền', token: '--border', role: 'Đường kẻ, viền thẻ' },
  { name: 'Viền đậm', token: '--border-strong', role: 'Viền khi rê chuột' },
  { name: 'Viền ô nhập', token: '--input', role: 'Viền ô nhập', min: 3 },
  { name: 'Mờ', token: '--faint', role: 'Chỉ trang trí, không dùng cho chữ' },
  { name: 'Chữ phụ', token: '--muted', role: 'Ngày, mô tả, nhãn', min: 4.5 },
  { name: 'Thân bài', token: '--text', role: 'Đoạn văn', min: 4.5 },
  { name: 'Tiêu đề', token: '--fg', role: 'Tiêu đề, chữ nhấn', min: 4.5 },
  { name: 'Tô sáng', token: '--mark', role: 'Nền chữ khớp khi tìm' },
];

const hues: Swatch[] = [
  { name: 'Toán học', token: '--blue', role: 'Chấm và nhãn lĩnh vực', min: 4.5 },
  { name: 'AI & Học máy', token: '--green', role: 'Chấm và nhãn lĩnh vực', min: 4.5 },
  { name: 'Triết học', token: '--violet', role: 'Chấm và nhãn lĩnh vực', min: 4.5 },
  { name: 'Diễn ngôn & Chính trị', token: '--red', role: 'Chấm và nhãn lĩnh vực', min: 4.5 },
];

const scale = [
  {
    role: 'Tiêu đề trang',
    cls: 'text-display',
    spec: '32–44 / 1.12 / 600 / −0.03em',
    sample: 'Định lý Bất toàn của Gödel',
  },
  {
    role: 'Tiêu đề mục',
    cls: 'text-h2',
    spec: '22 / 1.3 / 600 / −0.02em',
    sample: 'Giấc mơ của Hilbert và nền móng toán học',
  },
  { role: 'Tiêu đề phụ', cls: 'text-h3', spec: '19 / 1.35 / 600 / −0.015em', sample: 'Mã hóa Gödel từng bước' },
  {
    role: 'Tên bài trong danh sách',
    cls: 'text-title',
    spec: '17 / 1.4 / 500 / −0.012em',
    sample: 'Bài toán dừng: giới hạn của mọi cỗ máy',
  },
  {
    role: 'Thân bài',
    cls: 'text-prose',
    spec: '17 / 1.75 / 400',
    sample:
      'Mùa thu năm 1930 tại Königsberg, David Hilbert tuyên bố rằng không có bài toán nào là không thể giải quyết. Chỉ một ngày trước đó, chàng thanh niên 24 tuổi Kurt Gödel đã lặng lẽ thông báo một kết quả ngược lại.',
  },
  {
    role: 'Mô tả',
    cls: 'text-small text-muted',
    spec: '15 / 1.6 / 400',
    sample: 'Turing chứng minh rằng không chương trình nào đoán trước được mọi chương trình khác có dừng hay không.',
  },
  {
    role: 'Giao diện',
    cls: 'text-ui font-medium text-fg',
    spec: '14 / 1.45 / 500',
    sample: 'Bài viết · Giới thiệu · Tìm kiếm',
  },
  { role: 'Chú thích, nhãn', cls: 'text-caption text-muted', spec: '13 / 1.5 / 400', sample: 'Toán học · 18 phút đọc' },
  {
    role: 'Số, ngày',
    cls: 'text-caption font-mono text-muted',
    spec: 'Geist Mono 13',
    sample: '10.01.2024 · sửa 15.10.2026',
  },
];
---

<BaseLayout title="Thành phần" description="Hệ thống thiết kế của Logos & Ethos." canonicalPath="/thanh-phan/" noindex>
  <div class="wrap py-16 sm:py-20">
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-display">Thành phần</h1>
        <p class="mt-3 max-w-[34rem] text-muted">
          Token và component của blog đặt cạnh nhau để soát. Bấm nút hoặc phím <kbd class="kbd">T</kbd> để đổi nền; số
          tương phản tính lại theo nền đang xem.
        </p>
      </div>
      <button type="button" class="tmp-toggle" data-theme-toggle aria-label="Đổi nền">
        Đổi nền
      </button>
    </header>

    <section class="spec" aria-labelledby="colors">
      <h2 id="colors">Màu trung tính</h2>
      <p class="note">
        Không có màu nhấn. Tương phản đo trên nền <code>--bg</code>; ngưỡng là WCAG 2.2 AA cho vai trò của màu.
      </p>
      <ul class="swatches">
        {neutrals.map((s) => (
          <li data-swatch={s.token} data-min={s.min}>
            <span class="chip" style={`background: var(${s.token})`} />
            <span class="name">{s.name}</span>
            <code class="token">{s.token}</code>
            <span class="role">{s.role}</span>
            <span class="ratio tabular" data-ratio />
          </li>
        ))}
      </ul>
    </section>

    <section class="spec" aria-labelledby="hues">
      <h2 id="hues">Màu lĩnh vực</h2>
      <p class="note">Màu duy nhất của blog, chỉ xuất hiện ở chấm nhỏ và nhãn lĩnh vực, luôn đi kèm tên.</p>
      <ul class="swatches">
        {hues.map((s) => (
          <li data-swatch={s.token} data-min={s.min}>
            <span class="chip" style={`background: var(${s.token})`} />
            <span class="name" style={`color: var(${s.token})`}>
              {s.name}
            </span>
            <code class="token">{s.token}</code>
            <span class="role">{s.role}</span>
            <span class="ratio tabular" data-ratio />
          </li>
        ))}
      </ul>
    </section>

    <section class="spec" aria-labelledby="type">
      <h2 id="type">Thang chữ</h2>
      <p class="note">Inter cho mọi chữ, Geist Mono cho số và code. Cỡ / dòng / đậm / giãn chữ.</p>
      <dl class="scale">
        {scale.map((t) => (
          <div>
            <dt>
              <span>{t.role}</span>
              <code>{t.spec}</code>
            </dt>
            <dd class={t.cls}>{t.sample}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="spec" aria-labelledby="diacritics">
      <h2 id="diacritics">Dấu tiếng Việt</h2>
      <p class="note">Dấu chồng hai tầng ở dòng chật nhất (tiêu đề trang, dòng 1.12) không được chạm dòng trên.</p>
      <p class="text-display text-fg">Những ước muốn ở ngưỡng cửa hữu hạn — Ỷ Ễ Ỗ Ữ Ặ</p>
      <p class="mt-6 text-prose">
        <i>Nghiêng thật của Inter: “Wir müssen wissen, wir werden wissen”, ấy là lời nguyện ước của thế kỷ.</i>
        <b> Đậm 600 ở cỡ thân bài.</b>
      </p>
    </section>

    <section class="spec" aria-labelledby="numbers">
      <h2 id="numbers">Số</h2>
      <p class="note">Số trong bảng và ngày tháng dùng chữ số đều nhau để các cột thẳng hàng.</p>
      <div class="numbers">
        <p>
          <span class="label">Tỉ lệ</span>
          <span class="tabular">111 111</span>
          <span class="tabular">999 999</span>
        </p>
        <p>
          <span class="label">Mono</span>
          <span class="font-mono">10.01.2024</span>
          <span class="font-mono">28.09.2026</span>
        </p>
      </div>
    </section>

    <section class="spec" aria-labelledby="shape">
      <h2 id="shape">Hình khối</h2>
      <p class="note">
        Bo 6px cho nút nhỏ và nhãn, 8px cho nút và ô nhập, 12px cho thẻ. Bóng chỉ dùng cho lớp nổi; ở nền tối bóng được
        thay bằng một viền sáng mảnh.
      </p>
      <div class="shapes">
        <div style="border-radius: var(--radius-sm)">6px</div>
        <div style="border-radius: var(--radius-md)">8px</div>
        <div style="border-radius: var(--radius-lg)">12px</div>
        <div class="raised">Lớp nổi</div>
      </div>
    </section>

    <section class="spec" aria-labelledby="focus">
      <h2 id="focus">Vòng focus</h2>
      <p class="note">Bấm Tab để thấy. Chỉ hiện khi dùng bàn phím, cách mép 2px.</p>
      <p class="flex flex-wrap items-center gap-4 text-ui">
        <a href="#focus">Một liên kết</a>
        <button type="button" class="tmp-toggle">
          Một nút
        </button>
        <a href="#focus" class="underline">
          Liên kết trong câu
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  /** WCAG relative luminance of an `rgb()` string from getComputedStyle. */
  function luminance(rgb: string): number {
    const [r, g, b] = (rgb.match(/[\d.]+/g) ?? []).slice(0, 3).map((v) => {
      const c = Number(v) / 255;
      return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  }

  function contrast(a: string, b: string): number {
    const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
    return (hi + 0.05) / (lo + 0.05);
  }

  function measure() {
    const bg = getComputedStyle(document.body).backgroundColor;
    document.querySelectorAll<HTMLElement>('[data-swatch]').forEach((item) => {
      const chip = item.querySelector<HTMLElement>('.chip');
      const out = item.querySelector<HTMLElement>('[data-ratio]');
      if (!chip || !out) return;
      const ratio = contrast(getComputedStyle(chip).backgroundColor, bg);
      const min = Number(item.dataset.min);
      out.textContent = `${ratio.toFixed(2)}:1`;
      out.dataset.state = !min ? 'none' : ratio >= min ? 'pass' : 'fail';
      out.title = min ? `Cần ≥ ${min}:1` : 'Không dùng cho chữ';
    });
  }

  measure();
  new MutationObserver(measure).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>

<style>
  .spec {
    margin-top: 4rem;
  }

  .spec > h2 {
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note {
    margin-top: 0.25rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .spec > :not(h2, .note) {
    margin-top: 1.25rem;
  }

  .swatches {
    display: grid;
    border-block: 1px solid var(--border);
    list-style: none;
  }

  .swatches li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    column-gap: 0.875rem;
    align-items: center;
    padding-block: 0.625rem;
    font-size: var(--text-caption);
  }

  .swatches li + li {
    border-top: 1px solid var(--border);
  }

  .chip {
    grid-row: span 2;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px rgb(127 127 127 / 0.25);
  }

  .name {
    color: var(--fg);
    font-size: var(--text-ui);
    font-weight: 500;
  }

  .token {
    justify-self: end;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .role {
    color: var(--muted);
  }

  .ratio {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .ratio[data-state='none'] {
    color: var(--muted);
  }

  .ratio[data-state='pass'] {
    color: var(--fg);
  }

  .ratio[data-state='fail'] {
    color: var(--red);
  }

  .ratio[data-state='pass']::after {
    content: ' ✓';
  }

  .ratio[data-state='fail']::after {
    content: ' ✗';
  }

  .scale {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .scale > div {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .scale dt {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    color: var(--muted);
    font-size: var(--text-caption);
  }

  .scale dt code {
    font-size: 0.75rem;
  }

  .scale dd:where(.text-display, .text-h2, .text-h3, .text-title) {
    color: var(--fg);
  }

  .numbers {
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-prose);
  }

  .numbers p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .label {
    width: 4rem;
    color: var(--muted);
    font-size: var(--text-caption);
    align-self: center;
  }

  .shapes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }

  .shapes div {
    display: grid;
    place-items: center;
    height: 5rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .shapes .raised {
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--raised);
    box-shadow: var(--shadow-raised);
  }

  /* Stand-ins until the Button and Kbd components land in phase 2. */
  .tmp-toggle {
    height: 2.25rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--text-ui);
    font-weight: 500;
  }

  .kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    color: var(--fg);
    font-size: 0.75rem;
  }
</style>
