---
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/ui/Button.astro';
import Kbd from '../components/ui/Kbd.astro';
import { routes } from '../lib/routes';
---

<SiteLayout title="Không tìm thấy trang" description="Trang này không tồn tại." canonicalPath="/404/" noindex>
  <div class="wrap page">
    <p class="code" aria-hidden="true">
      ∄
    </p>
    <h1>Trang này không có ở đây.</h1>
    <p class="lead">
      Có thể đường dẫn đã đổi, hoặc trang chưa từng tồn tại. Thử tìm bài viết bằng <Kbd>Ctrl K</Kbd>, hoặc về danh sách
      bài.
    </p>
    <div class="actions">
      <Button href={routes.home}>Về trang chủ</Button>
      <Button variant="outline" data-palette-open aria-haspopup="dialog">
        Tìm bài viết
      </Button>
    </div>
  </div>
</SiteLayout>

<style>
  .page {
    padding-top: clamp(4rem, 14vh, 8rem);
  }

  .code {
    color: var(--faint);
    font-size: 4rem;
    line-height: 1;
  }

  h1 {
    margin-top: 1.5rem;
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
  }

  .lead {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--text-prose);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
</style>
