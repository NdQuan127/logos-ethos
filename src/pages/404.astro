---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../lib/routes';
---

<BaseLayout title="Nghịch lý 404" description="Sự hiện diện của thứ gì đó không tồn tại." canonicalPath="/404/">
  <main class="flex min-h-svh flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-[clamp(6rem,4rem+10vw,12rem)] leading-none text-accent-soft italic" aria-hidden="true">
      ∄
    </p>
    <p class="eyebrow mt-6">Lỗi 404 · Nghịch lý sự vắng mặt</p>
    <h1 class="mt-4 max-w-lg font-display text-[clamp(2.25rem,1.8rem+2vw,3.25rem)] leading-[1.05] font-normal text-balance">
      Trang bạn tìm <em class="italic">không có ở đây.</em>
    </h1>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">
      Có lẽ nó đã bị triệt tiêu bởi một mệnh đề sai, hoặc đơn giản là chưa bao giờ tồn tại.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={routes.home} class="btn">
        Về trang chủ
      </a>
      <a href={routes.blog} class="btn btn-ghost">
        Mọi bài viết
      </a>
    </div>
  </main>
</BaseLayout>
