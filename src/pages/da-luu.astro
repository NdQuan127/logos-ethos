---
import ListingLayout from '../layouts/ListingLayout.astro';
import PostGrid from '../components/post/PostGrid.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { site } from '../config/site';
import { getPosts } from '../lib/content';
import { routes } from '../lib/routes';

if (!site.features.bookmarks) return Astro.redirect(routes.home);

// Every post is rendered hidden; the client script reveals the saved ones.
const posts = await getPosts();
---

<ListingLayout
  title="Bài đã lưu"
  description="Các bài viết bạn đã lưu trên thiết bị này."
  canonicalPath={routes.saved}
  header={{
    eyebrow: 'Đọc sau',
    title: 'Bài',
    titleAccent: 'đã lưu',
    description: 'Danh sách này được lưu ngay trên trình duyệt của bạn, không cần tài khoản.',
  }}
  sectionLabel="Danh sách bài đã lưu"
>
  <script>
    import { initSaved } from '../scripts/saved';
    initSaved();
  </script>
  <p data-saved-status class="sr-only" role="status"></p>
  <PostGrid posts={posts} data-saved-list itemAttributes={(post) => ({ 'data-saved-slug': post.slug, hidden: true })} />
  <EmptyState
    data-saved-empty
    hidden
    title="Bạn chưa lưu bài nào."
    description="Nhấn “Lưu” ở cuối mỗi bài viết để đọc lại sau."
  >
    <a
      href={routes.blog}
      class="inline-flex min-h-11 items-center border border-line px-6 font-mono text-sm uppercase tracking-wider text-fg hover:border-accent hover:text-accent transition-colors"
    >
      Xem tất cả bài viết
    </a>
  </EmptyState>
  <noscript>
    <p class="font-sans text-muted">Cần bật JavaScript để xem danh sách bài đã lưu trên trình duyệt này.</p>
  </noscript>
</ListingLayout>
