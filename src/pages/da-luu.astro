---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { getAllPosts } from '../lib/blog';

const posts = await getAllPosts();
---

<BaseLayout title="Bài đã lưu" description="Các bài viết bạn đã lưu trên thiết bị này." canonicalPath="/da-luu/">
  <script>
    import '../scripts/saved.ts';
  </script>
  <div class="min-h-screen flex flex-col relative font-serif">
    <Navbar />
    <main id="main-content" class="flex-grow">
      <header class="w-full py-20 md:py-28 px-6 md:px-12 border-b border-[var(--border-color)]">
        <div class="max-w-7xl mx-auto relative z-10">
          <p class="mb-6 font-mono text-xs uppercase tracking-widest text-[var(--accent-primary)] animate-fade-in">Đọc sau</p>
          <h1 class="font-serif text-5xl md:text-7xl text-[var(--foreground)] font-medium leading-tight animate-fade-in-up">
            Bài <span class="italic font-light text-[var(--muted)]">đã lưu</span>
          </h1>
          <p class="font-sans text-[var(--muted)] text-lg mt-6 max-w-xl leading-relaxed animate-fade-in-up">
            Danh sách này được lưu ngay trên trình duyệt của bạn, không cần tài khoản.
          </p>
        </div>
      </header>
      <section class="w-full py-16 px-6 md:px-12" aria-label="Danh sách bài đã lưu">
        <div class="max-w-7xl mx-auto">
          <p data-saved-status class="sr-only" role="status"></p>
          <ul data-saved-list class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <li data-saved-slug={post.slug} hidden>
                <ArticleCard post={post} />
              </li>
            ))}
          </ul>
          <div data-saved-empty hidden class="text-center py-24">
            <p class="font-serif text-3xl text-[var(--muted)] italic mb-4">Bạn chưa lưu bài nào.</p>
            <p class="font-sans text-[var(--muted)] text-sm mb-8">Nhấn “Lưu” ở cuối mỗi bài viết để đọc lại sau.</p>
            <a href="/blog/" class="inline-flex min-h-11 items-center border border-[var(--border-color)] px-6 font-mono text-sm uppercase tracking-wider text-[var(--foreground)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition-colors">
              Xem tất cả bài viết
            </a>
          </div>
          <noscript>
            <p class="font-sans text-[var(--muted)]">Cần bật JavaScript để xem danh sách bài đã lưu trên trình duyệt này.</p>
          </noscript>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
