---
/**
 * Every regular page: header, a single <main id="main-content"> and the footer.
 */
import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';

interface Props extends BaseProps {
  /** Turn the header hairline into a reading-progress bar. */
  progress?: boolean;
}

const { progress, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps}>
  <slot name="head" slot="head" />
  <div class="flex min-h-svh flex-col">
    <Header progress={progress} />
    <main id="main-content" tabindex="-1" class="flex-grow outline-none">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
