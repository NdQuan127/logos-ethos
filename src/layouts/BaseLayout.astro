---
/**
 * The HTML document: <head> metadata, theme bootstrap and global scripts.
 * Pages normally use SiteLayout (or a layout built on it) instead.
 */
import '../styles/fonts.css';
import '../styles/global.css';
import { site } from '../config/site';
import { routes } from '../lib/routes';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  /** Social preview image, absolute or root-relative. */
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: unknown;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = '/',
  image,
  type = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
const canonicalUrl = new URL(canonicalPath, site.url).toString();
const socialImage = image ? new URL(image, site.url).toString() : undefined;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F7F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1B1A" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', stored === 'dark' || (!stored && prefersDark));
        } catch {
          // Storage can be blocked; the page then starts in the light theme.
        }
      })();
    </script>
    <link rel="alternate" type="application/rss+xml" title={site.title} href={new URL(routes.rss, site.url)} />
    <slot name="head" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="antialiased selection:bg-academic-yellow/30">
    <slot />
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
