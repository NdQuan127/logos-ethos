---
/**
 * A blog post: header, table of contents, rendered MDX, sources, tags and the
 * neighbouring posts. Pages only pass the post.
 */
// Linked per page instead of bundled, so posts without math skip it.
import katexHref from 'katex/dist/katex.min.css?url';
import { ArrowLeft, Check, Link } from '@lucide/astro';
import { Image } from 'astro:assets';
import { PROSE_IMAGE_SIZES } from '../lib/rehype-blocks';
import { render } from 'astro:content';
import '../styles/prose.css';
import SiteLayout from './SiteLayout.astro';
import { mdxComponents } from '../components/mdx';
import PostNav from '../components/post/PostNav.astro';
import SourceList from '../components/post/SourceList.astro';
import TableOfContents from '../components/post/TableOfContents.astro';
import TagList from '../components/post/TagList.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import IconSwap from '../components/ui/IconSwap.astro';
import { site } from '../config/site';
import { getNeighbours, getPosts, type PostView } from '../lib/content';
import { formatLongDate } from '../lib/format';
import { routes } from '../lib/routes';

interface Props {
  post: PostView;
}

const { post } = Astro.props;
const posts = await getPosts();
const { newer, older } = getNeighbours(posts, post);
const { Content, headings, remarkPluginFrontmatter } = await render(post.entry);

// Sections only: a list of every ### grows longer than the screen.
// `footnote-label` is the heading of the footnotes section that remark-rehype adds.
const hasFootnotes = headings.some((heading) => heading.slug === 'footnote-label');
const tocEntries = post.toc
  ? [
      ...headings.filter((heading) => heading.depth === 2 && heading.slug !== 'footnote-label'),
      ...(hasFootnotes ? [{ slug: 'footnote-label', text: 'Chú thích' }] : []),
      ...(post.sources.length > 0 ? [{ slug: 'sources', text: 'Tài liệu tham khảo' }] : []),
    ]
  : [];
const showToc = tocEntries.length >= 3;

const ogImage = routes.ogImage(post.slug);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.isoDate,
  ...(post.updatedIsoDate && { dateModified: post.updatedIsoDate }),
  url: new URL(post.href, site.url).toString(),
  image: new URL(ogImage, site.url).toString(),
  inLanguage: site.lang,
  publisher: { '@type': 'Organization', name: site.title, url: site.url },
  articleSection: post.category.name,
  ...(post.tags.length > 0 && { keywords: post.tags.map((tag) => tag.name).join(', ') }),
  timeRequired: `PT${post.readingTime}M`,
};
---

<SiteLayout
  title={post.title}
  description={post.description}
  canonicalPath={post.href}
  image={ogImage}
  type="article"
  jsonLd={jsonLd}
  progress
>
  {remarkPluginFrontmatter.hasMath && <link slot="head" rel="stylesheet" href={katexHref} />}

  {showToc && <TableOfContents entries={tocEntries} variant="sidebar" />}

  <div class="wrap">
    <article class="article">
      <header class="head">
        <a href={routes.home} class="back">
          <ArrowLeft size={14} stroke-width={1.75} aria-hidden="true" />
          Bài viết
        </a>
        {post.draft && <p class="draft">Bản nháp: chỉ hiện khi chạy dev, không có trong bản build</p>}
        <h1>{post.title}</h1>
        <p class="desc">{post.description}</p>
        <div class="meta">
          <Badge href={post.category.href} tone={post.category.tone}>
            {post.category.name}
          </Badge>
          <p class="dates">
            <time datetime={post.isoDate} title={formatLongDate(post.date)}>
              {post.dateLabel}
            </time>
            {post.updated && post.updatedLabel !== post.dateLabel && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  sửa{' '}
                  <time datetime={post.updatedIsoDate} title={formatLongDate(post.updated)}>
                    {post.updatedLabel}
                  </time>
                </span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span>{post.readingTime} phút đọc</span>
          </p>
          <Button variant="ghost" size="sm" icon label="Chép liên kết bài viết" class="share" data-copy-link>
            <IconSwap>
              <Link slot="from" aria-hidden="true" />
              <Check slot="to" aria-hidden="true" />
            </IconSwap>
          </Button>
        </div>
      </header>

      {post.cover && post.coverAlt && (
        <Image
          src={post.cover}
          alt={post.coverAlt}
          class="cover"
          widths={[640, 960, 1280]}
          sizes={PROSE_IMAGE_SIZES}
          loading="eager"
        />
      )}

      {showToc && <TableOfContents entries={tocEntries} variant="inline" />}

      <div class="prose">
        <Content components={mdxComponents} />
      </div>

      <SourceList sources={post.sources} />
      <TagList tags={post.tags} />
    </article>

    <PostNav newer={newer} older={older} />
  </div>

  <dialog class="zoom" data-zoom aria-label="Ảnh phóng to"></dialog>
</SiteLayout>

<script>
  import { initArticle } from '../scripts/article';
  initArticle();
</script>

<style>
  .head {
    padding-top: clamp(2rem, 6vh, 3.5rem);
  }

  .back {
    min-height: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted);
    font-size: var(--text-caption);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .back :global(svg) {
    transition: translate 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      color: var(--fg);
    }

    .back:hover :global(svg) {
      translate: -2px 0;
    }
  }

  .draft {
    width: fit-content;
    margin-top: 1.25rem;
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.75rem;
  }

  h1 {
    margin-top: 1.5rem;
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    overflow-wrap: break-word;
  }

  .desc {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin-top: 1.75rem;
    padding-block: 0.625rem;
    border-block: 1px solid var(--border);
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .meta :global(.share) {
    margin-inline-start: auto;
  }

  .cover {
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .prose {
    margin-top: 2.5rem;
  }
</style>
